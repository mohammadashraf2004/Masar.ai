# deploy/production.env.example
#
# Template for the production environment. Copy to a file that is NEVER
# committed, fill in real values, and keep it root-owned and mode 600:
#
#   cp deploy/production.env.example /etc/masar/production.env
#   chown root:root /etc/masar/production.env
#   chmod 600 /etc/masar/production.env
#
# Then deploy with:
#   docker compose --env-file /etc/masar/production.env \
#     -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# Verify presence (never prints values) before starting:
#   ./deploy/verify-secrets.sh /etc/masar/production.env
#
# ── On the choice of mechanism ───────────────────────────────────────────
# DEPLOYMENT.md §2 deliberately leaves the injection mechanism open
# ("compose .env, Kubernetes Secrets, SSM/Secrets Manager, Vault — your
# choice"). The repository does not ship or assume any one of them, so this
# file is the plain Compose form: the mechanism that works with the
# docker-compose.yml already in the repo and needs no new infrastructure.
#
# If you already run a secret manager, use it instead and have it render
# this file (or export these names) at deploy time. Nothing in the
# application reads a secret from anywhere except the process environment,
# so any mechanism that populates the environment works unchanged.
#
# What must never happen, whichever mechanism you pick: these values in
# Git, in an image layer, in a Dockerfile, or in a log. backend/.dockerignore
# now enforces the image half of that (see F-1 in LAUNCH_CHECKLIST.md).

# ── Core ────────────────────────────────────────────────────────────────
APP_ENV=production
# openssl rand -hex 32
SECRET_KEY=
# Least-privilege role, NOT the superuser. Append ?sslmode=require.
# Role creation SQL is in DEPLOYMENT.md §2.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=https://example.com
# openssl rand -hex 16
METRICS_TOKEN=
METRICS_ENABLED=true

# ── Database ────────────────────────────────────────────────────────────
POSTGRES_USER=
# WARNING (F-4): Postgres applies this ONLY when initialising an EMPTY data
# directory. On a volume that already exists, setting it here changes
# nothing — you must ALTER ROLE inside the database and update this to match.
POSTGRES_PASSWORD=
POSTGRES_DB=ai_career_platform

# ── AI provider ─────────────────────────────────────────────────────────
GENERATION_BACKEND=openai
GENERATION_MODEL_ID=
# MUST be the ROTATED key. The previous one was baked into image layers and
# is compromised — see F-1.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Email (required in production) ──────────────────────────────────────
# Credit-spending requires a verified address and the mail client fails
# soft; without this, no account can ever verify or spend.
RESEND_API_KEY=
EMAIL_FROM=

# ── Payments (Paymob) ───────────────────────────────────────────────────
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_IFRAME_ID=
# Without this, verify_webhook_hmac() returns False and NO payment is ever
# confirmed. Silent revenue loss.
PAYMOB_HMAC_SECRET=

# ── Reverse proxy ───────────────────────────────────────────────────────
# 1 for a single Caddy/nginx/ALB in front; 2 for CDN + load balancer.
# Too HIGH is the dangerous direction — it reads into attacker-controlled
# X-Forwarded-For entries.
TRUSTED_PROXY_COUNT=1
# Required whenever the count is > 0, or the app refuses to boot.
# With docker-compose.prod.yml the proxy is on the compose network:
TRUSTED_PROXY_IPS=172.16.0.0/12
EXTRA_CORS_ORIGINS=

# ── Ops ─────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=
# Passphrase used to encrypt database dumps at rest (deploy/backup/pg-backup.sh).
# Store it somewhere you can still reach when the database is gone — a
# backup you cannot decrypt is not a backup.
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6

# Off-host copy of the same encrypted artifact — see DEPLOYMENT.md §3.
# No default in docker-compose.prod.yml: this must be set to true or
# false explicitly. false is honest if S3 is not configured yet; leaving
# this line blank/unset is not — the stack refuses to boot until it is
# one or the other.
BACKUP_REMOTE_ENABLED=false
# Everything below is required only when BACKUP_REMOTE_ENABLED=true.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=masar/postgres
BACKUP_S3_REGION=
# Least-privilege IAM credentials, scoped to PutObject/GetObject/
# HeadObject/ListBucket on the bucket+prefix above only — see
# DEPLOYMENT.md §3 for the exact policy. Never the account's admin keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Leave both blank for real AWS S3. Only set BACKUP_S3_ENDPOINT_URL for an
# S3-compatible target that is not AWS (MinIO, Cloudflare R2, a disaster-
# recovery drill against a local emulator).
BACKUP_S3_ENDPOINT_URL=
# AES256 (SSE-S3) is the default the script applies once remote backup is
# on and needs nothing further here. aws:kms requires BACKUP_S3_KMS_KEY_ID
# below; none disables server-side encryption (the client-side AES-256
# layer already applied to the artifact is unaffected either way).
BACKUP_S3_SSE=AES256
BACKUP_S3_KMS_KEY_ID=

# ── Alerting ────────────────────────────────────────────────────────────
# Slack or Discord incoming-webhook URL. Alertmanager posts here.
ALERT_RECEIVER_URL=
# Optional SMTP, if you prefer email alerts (see deploy/alertmanager.yml)
ALERT_SMTP_SMARTHOST=
ALERT_SMTP_FROM=
ALERT_SMTP_TO=

# ── Domains ─────────────────────────────────────────────────────────────
# Used by deploy/Caddyfile for automatic TLS.
DOMAIN=example.com
API_DOMAIN=api.example.com
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=

# ── Build argument (baked into the client bundle) ───────────────────────
# Changing this needs an image REBUILD, not a restart.
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
