curriculum/
ai_engineer_track/
node_modules/
.next/
.env
.env.local


# TypeScript incremental build cache (created by `npm run typecheck`)
*.tsbuildinfo

# prometheus_client multiprocess state — one mmap file per worker PID,
# written to PROMETHEUS_MULTIPROC_DIR (or the cwd when it is empty or
# relative). Pure runtime state; see backend/app/core/metrics.py.
counter_*.db
gauge_livesum_*.db
histogram_*.db

# A Windows-absolute PROMETHEUS_MULTIPROC_DIR reaching a POSIX-style path
# join gets treated as RELATIVE, which once created a literal `backend/C:/…`
# tree inside the repo. The metric files themselves already match the
# patterns above, but the stray directory could carry anything, so ignore
# the whole shape. Nothing legitimate is ever named this.
backend/C:/
**/[A-Za-z]:/

# Python bytecode — was tracked by mistake; removed from the index
# (files kept on disk) so runs stop dirtying the working tree.
__pycache__/
*.py[cod]
