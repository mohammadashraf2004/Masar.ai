# Template only — PLACEHOLDERS, never real values.
#
# Copy to backend/.env (gitignored) and fill in locally. Never commit a
# real .env, and never put a server-side secret in the frontend: anything
# prefixed NEXT_PUBLIC_ is compiled into the JavaScript bundle every
# visitor downloads.

# ─── App ──────────────────────────────────────────────────────────────────
APP_NAME="Masar"
# development | production. Anything that isn't development/dev/local/
# test/testing is treated as production (see app/core/config.py), which
# turns on the startup safety checks, disables /docs, hides diagnostic
# fields from /health, drops localhost from the CORS allowlist, and sends
# HSTS.
APP_ENV=development

# JWT signing key. Generate a real one — the app REFUSES to start in
# production with this placeholder or anything shorter than 32 chars:
#   openssl rand -hex 32
# Rotating it invalidates every outstanding session, by design.
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
# 12 hours. The browser client holds this token in localStorage, so a
# short lifetime is what bounds the damage from an XSS. Don't raise it
# without reading the "token storage" note in SECURITY.md.
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Bound into every token and required at verification, so a token minted
# by another service that shares this key can't be replayed here.
JWT_ISSUER=ai-career-platform
JWT_AUDIENCE=ai-career-platform-api

# Failed logins per (email, IP) before that pair is locked out, and for
# how long. This is the control that bites credential stuffing; the
# per-IP rate limit alone does not.
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_MINUTES=15

# ─── Database ───────────────────────────────────────────────────────────────
# When running via `docker compose up`, docker-compose.yml always overrides
# this to point at the `db` service regardless of what's set here — a
# host-local address wouldn't resolve inside the container network anyway.
# This value only matters if you run the backend natively (no Docker).
#
# Production: use a dedicated least-privilege role (SELECT/INSERT/UPDATE/
# DELETE on the app schema, no SUPERUSER, no CREATEDB/CREATEROLE), require
# TLS (?sslmode=require), and keep the instance off any public network.
# The app refuses to start in production while this still reads
# localhost / password@.
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_career_platform

# ─── Rate limiting ──────────────────────────────────────────────────────────
# REQUIRED for any multi-worker or multi-replica deployment. Without it,
# slowapi keeps per-process counters, so gunicorn's 4 workers each enforce
# their own budget and every documented limit is effectively 4x looser.
# REDIS_URL=redis://redis:6379/0
REDIS_URL=

# ─── Metrics (Prometheus) ─────────────────────────────────────────────────
# /metrics is served by the API on its own published port, so it is gated
# by a bearer token — the payload maps every route, its latency and error
# rate, plus credit burn and auth-failure counts. Prometheus reads the same
# value from METRICS_TOKEN (see docker-compose.yml).
# Generate one with: openssl rand -hex 32
# The app refuses to boot in production with METRICS_ENABLED=true and no
# token. Set METRICS_ENABLED=false to turn the endpoint off entirely.
METRICS_ENABLED=true
METRICS_TOKEN=

# ─── Grafana ──────────────────────────────────────────────────────────────
# Bound to 127.0.0.1 by docker-compose. Change these before exposing it
# through any proxy — the defaults are admin/admin.
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ─── AI provider ──────────────────────────────────────────────────────────
# "openai" or "anthropic". Set the matching API key below.
GENERATION_BACKEND=openai
GENERATION_MODEL_ID=gpt-4o-mini
# Hard cap on prompt size sent to the provider — the last line of defence
# against a caller-chosen multiplier on the inference bill.
INPUT_DEFAULT_MAX_CHARACTERS=10000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Self-hosted / gateway inference (optional) ───────────────────────────
# Any OpenAI-compatible endpoint. Leave blank to use api.openai.com.
# The value is server-side configuration only — it is never influenced by
# a request, so it is not an SSRF surface. Keep it on the private network;
# if it ever crosses a public network, it must be https.
#
#   Ollama          OPENAI_API_URL=http://ollama:11434/v1
#   vLLM            OPENAI_API_URL=http://vllm:8000/v1
#   LM Studio       OPENAI_API_URL=http://host.docker.internal:1234/v1
#   LiteLLM gateway OPENAI_API_URL=http://litellm:4000
#   OpenRouter      OPENAI_API_URL=https://openrouter.ai/api/v1
#
# With a local server, also set GENERATION_BACKEND=openai and
# GENERATION_MODEL_ID to that server's model name (e.g. llama3.1:8b).
# The OpenAI SDK requires a non-empty api key even when the server
# ignores it — put any placeholder in OPENAI_API_KEY.
OPENAI_API_URL=

# ─── Launch promotion (optional) ─────────────────────────────────────────
# A larger signup grant while the platform is finding its first users.
# CREDITS ONLY — the certification exam fee is a separate, EGP-only
# paywall and is deliberately NOT affected by this.
#
# LAUNCH_PROMO_UNTIL bounds the OFFER: accounts created after this date
# get the ordinary 10 welcome credits instead. Blank — or an unparseable
# date — disables the promo, so a typo fails closed rather than granting
# free credits forever. Format YYYY-MM-DD (end of day, UTC).
LAUNCH_PROMO_UNTIL=
# Credits granted to accounts created during the window.
LAUNCH_PROMO_CREDITS=500
# Unspent promo credits are withdrawn this many days after that user
# signed up, so the giveaway doesn't become an open-ended liability.
# Credits the user PURCHASED are never touched. 0 disables expiry.
LAUNCH_PROMO_DAYS=30

# ─── Track availability ─────────────────────────────────────────────────────
# Comma-separated slugs of the career tracks open for enrolment. Every other
# track in the catalogue is still listed and browsable, but POST
# /tracks/enroll rejects it with a 403 — the rest are seeded as shells, so
# enrolling would hand someone an empty track. Opening one up is a content
# seed plus an entry here. Empty closes enrolment on every track.
AVAILABLE_TRACK_SLUGS=ai-developer

# ─── CORS ───────────────────────────────────────────────────────────────────
# In production this must be the real https origin — it is the ONLY
# allowed origin unless EXTRA_CORS_ORIGINS adds more, and credentials are
# enabled, so anything listed here can read authenticated responses.
FRONTEND_URL=http://localhost:3000
# Comma-separated extra allowed origins (staging/prod domains), e.g.:
# EXTRA_CORS_ORIGINS=https://app.example.com,https://staging.example.com
EXTRA_CORS_ORIGINS=

# ─── Email (Resend) -- optional, sending is best-effort if unset ──────────
RESEND_API_KEY=
EMAIL_FROM=Masar <noreply@example.com>

# ─── Payments (Paymob) -- optional, only needed for real payment flows ────
# PAYMOB_HMAC_SECRET is what makes the webhook trustworthy: without it,
# verify_webhook_hmac() returns False and no payment is ever confirmed.
# It must never be exposed to the browser.
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
