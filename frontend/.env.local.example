NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public origin of the app. Only used to build absolute OpenGraph image URLs
# for link previews — leave it unset locally and previews point at localhost.
NEXT_PUBLIC_SITE_URL=https://example.com

# ─── Payments ─────────────────────────────────────────────────────────────
# Which PaymentProvider the billing page uses (lib/billing/payments.ts).
# Unset: the mock provider in development, and no provider at all in a
# production build (nothing can appear to succeed). Set to "kashier" once
# the backend's Kashier credentials (backend/.env KASHIER_*) are configured,
# to send checkout through Kashier's hosted page.
NEXT_PUBLIC_PAYMENTS_PROVIDER=
# Force the mock provider in a production build (e.g. a staging site) —
# never set this in the real production environment.
NEXT_PUBLIC_PAYMENTS_MOCK=

# Mentor v2 endpoints graduate independently; omit to keep every endpoint on its local fixture.
NEXT_PUBLIC_MENTOR_V2_LIVE=message,quiz
