NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public origin of the app. Only used to build absolute OpenGraph image URLs
# for link previews — leave it unset locally and previews point at localhost.
NEXT_PUBLIC_SITE_URL=https://example.com

# Mentor v2 endpoints that call the real API; the rest stay on the mock.
# Comma-separated: message, quiz (later: review, plan, report).
NEXT_PUBLIC_MENTOR_V2_LIVE=message,quiz
